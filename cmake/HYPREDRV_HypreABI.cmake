include(CheckTypeSize)
include(CheckCSourceCompiles)

# Compile-only probes keep this usable for cross compilation and unbuilt HYPRE
# targets. Results are reused across reconfigures only when everything that can
# change them is unchanged: the compiler, include paths, definitions, and the
# content of the headers that define the ABI. A HYPRE or MPI reinstalled into
# the same prefix therefore still triggers a fresh probe.
function(_hypredrv_abi_probe_key key_out)
    set(_key "${CMAKE_C_COMPILER}|${CMAKE_C_COMPILER_VERSION}|${CMAKE_C_FLAGS}")
    string(APPEND _key "|${CMAKE_REQUIRED_INCLUDES}|${CMAKE_REQUIRED_DEFINITIONS}")
    foreach(_header IN LISTS ARGN)
        set(_found "")
        foreach(_dir IN LISTS CMAKE_REQUIRED_INCLUDES)
            if(EXISTS "${_dir}/${_header}")
                file(SHA256 "${_dir}/${_header}" _hash)
                set(_found "${_dir}/${_header}=${_hash}")
                break()
            endif()
        endforeach()
        string(APPEND _key "|${_found}")
    endforeach()
    string(SHA256 _digest "${_key}")
    set(${key_out} "${_digest}" PARENT_SCOPE)
endfunction()

function(hypredrv_get_hypre_abi_sizes int_bytes_out bigint_bytes_out real_bytes_out complex_bytes_out)
    if(COMMAND hypredrv_collect_hypre_include_dirs)
        hypredrv_collect_hypre_include_dirs(_includes INCLUDE_SOURCE_SUBDIRS)
    else()
        get_target_property(_includes HYPRE::HYPRE INTERFACE_INCLUDE_DIRECTORIES)
    endif()
    set(_plain_includes "")
    foreach(_include IN LISTS _includes)
        if(_include MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
            set(_include "${CMAKE_MATCH_1}")
        elseif(_include MATCHES "^\\$<")
            continue()
        endif()
        list(APPEND _plain_includes "${_include}")
    endforeach()
    set(CMAKE_REQUIRED_INCLUDES
        ${_plain_includes} ${MPI_C_INCLUDE_DIRS} ${CMAKE_C_IMPLICIT_INCLUDE_DIRECTORIES})
    if(TARGET MPI::MPI_C)
        get_target_property(_mpi_includes MPI::MPI_C INTERFACE_INCLUDE_DIRECTORIES)
        if(_mpi_includes)
            foreach(_include IN LISTS _mpi_includes)
                if(NOT _include MATCHES "^\\$<")
                    list(APPEND CMAKE_REQUIRED_INCLUDES "${_include}")
                endif()
            endforeach()
        endif()
    endif()
    get_directory_property(_definitions COMPILE_DEFINITIONS)
    list(APPEND _definitions ${MPI_C_COMPILE_DEFINITIONS})
    foreach(_target IN ITEMS HYPREDRV HYPRE::HYPRE MPI::MPI_C)
        if(TARGET ${_target})
            get_target_property(_target_definitions ${_target} INTERFACE_COMPILE_DEFINITIONS)
            if(_target_definitions)
                list(APPEND _definitions ${_target_definitions})
            endif()
            if(_target STREQUAL "HYPREDRV")
                get_target_property(_target_definitions ${_target} COMPILE_DEFINITIONS)
                if(_target_definitions)
                    list(APPEND _definitions ${_target_definitions})
                endif()
            endif()
        endif()
    endforeach()
    set(CMAKE_REQUIRED_DEFINITIONS "")
    foreach(_definition IN LISTS _definitions)
        if(_definition MATCHES "\\$<")
            # CheckTypeSize cannot evaluate target/configuration expressions.
            # Keep native builds usable and let Rust discovery fail closed
            # instead of recording sizes for a different compile context.
            foreach(_output IN ITEMS int_bytes_out bigint_bytes_out real_bytes_out complex_bytes_out)
                set(${${_output}} "" PARENT_SCOPE)
            endforeach()
            return()
        endif()
        list(APPEND CMAKE_REQUIRED_DEFINITIONS "-D${_definition}")
    endforeach()
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    set(CMAKE_REQUIRED_LIBRARIES "")
    set(CMAKE_REQUIRED_QUIET TRUE)
    _hypredrv_abi_probe_key(_key HYPRE_config.h HYPRE_utilities.h mpi.h)
    if(_HYPREDRV_HYPRE_ABI_KEY STREQUAL _key AND _HYPREDRV_HYPRE_ABI_SIZES)
        list(GET _HYPREDRV_HYPRE_ABI_SIZES 0 _int_bytes)
        list(GET _HYPREDRV_HYPRE_ABI_SIZES 1 _bigint_bytes)
        list(GET _HYPREDRV_HYPRE_ABI_SIZES 2 _real_bytes)
        list(GET _HYPREDRV_HYPRE_ABI_SIZES 3 _complex_bytes)
    else()
        set(CMAKE_EXTRA_INCLUDE_FILES HYPRE_utilities.h)
        foreach(_type IN ITEMS HYPRE_Int HYPRE_BigInt HYPRE_Real HYPRE_Complex)
            unset(_hypredrv_sizeof_${_type} CACHE)
            unset(HAVE__hypredrv_sizeof_${_type} CACHE)
            check_type_size("${_type}" _hypredrv_sizeof_${_type} LANGUAGE C)
        endforeach()
        set(_int_bytes "${_hypredrv_sizeof_HYPRE_Int}")
        set(_bigint_bytes "${_hypredrv_sizeof_HYPRE_BigInt}")
        set(_real_bytes "${_hypredrv_sizeof_HYPRE_Real}")
        set(_complex_bytes "${_hypredrv_sizeof_HYPRE_Complex}")
        if(_int_bytes AND _bigint_bytes AND _real_bytes AND _complex_bytes)
            set(_HYPREDRV_HYPRE_ABI_KEY "${_key}" CACHE INTERNAL "HYPRE ABI probe key")
            set(_HYPREDRV_HYPRE_ABI_SIZES
                "${_int_bytes};${_bigint_bytes};${_real_bytes};${_complex_bytes}"
                CACHE INTERNAL "HYPRE ABI probe sizes")
        endif()
    endif()
    set(${int_bytes_out} "${_int_bytes}" PARENT_SCOPE)
    set(${bigint_bytes_out} "${_bigint_bytes}" PARENT_SCOPE)
    set(${real_bytes_out} "${_real_bytes}" PARENT_SCOPE)
    set(${complex_bytes_out} "${_complex_bytes}" PARENT_SCOPE)
endfunction()

function(hypredrv_get_mpi_abi comm_bytes_out comm_kind_out family_out)
    set(CMAKE_REQUIRED_INCLUDES ${MPI_C_INCLUDE_DIRS} ${CMAKE_C_IMPLICIT_INCLUDE_DIRECTORIES})
    set(CMAKE_REQUIRED_LIBRARIES "")
    set(CMAKE_REQUIRED_DEFINITIONS "")
    set(_definitions ${MPI_C_COMPILE_DEFINITIONS})
    if(TARGET MPI::MPI_C)
        get_target_property(_includes MPI::MPI_C INTERFACE_INCLUDE_DIRECTORIES)
        get_target_property(_target_definitions MPI::MPI_C INTERFACE_COMPILE_DEFINITIONS)
        if(_includes)
            list(APPEND CMAKE_REQUIRED_INCLUDES ${_includes})
        endif()
        if(_target_definitions)
            list(APPEND _definitions ${_target_definitions})
        endif()
    endif()
    foreach(_definition IN LISTS _definitions)
        if(_definition MATCHES "\\$<")
            foreach(_output IN ITEMS comm_bytes_out comm_kind_out family_out)
                set(${${_output}} "" PARENT_SCOPE)
            endforeach()
            return()
        endif()
        list(APPEND CMAKE_REQUIRED_DEFINITIONS "-D${_definition}")
    endforeach()
    set(CMAKE_REQUIRED_QUIET TRUE)
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    _hypredrv_abi_probe_key(_key mpi.h)
    if(_HYPREDRV_MPI_ABI_KEY STREQUAL _key AND _HYPREDRV_MPI_ABI_VALUE)
        list(GET _HYPREDRV_MPI_ABI_VALUE 0 _comm_bytes)
        list(GET _HYPREDRV_MPI_ABI_VALUE 1 _comm_kind)
        list(GET _HYPREDRV_MPI_ABI_VALUE 2 _family)
    else()
        set(CMAKE_EXTRA_INCLUDE_FILES mpi.h)
        unset(_hypredrv_sizeof_MPI_Comm CACHE)
        unset(HAVE__hypredrv_sizeof_MPI_Comm CACHE)
        check_type_size(MPI_Comm _hypredrv_sizeof_MPI_Comm LANGUAGE C)
        set(_comm_bytes "${_hypredrv_sizeof_MPI_Comm}")
        # Only an integer handle can be used with the remainder operator. Once
        # integers are ruled out, any object pointer handle (including void * or
        # an incomplete struct pointer) converts implicitly to const void *.
        unset(_hypredrv_mpi_comm_integer CACHE)
        check_c_source_compiles(
            "#include <mpi.h>\nint main(void) {MPI_Comm comm = 0; (void)(comm % 1); return 0;}\n"
            _hypredrv_mpi_comm_integer)
        if(_hypredrv_mpi_comm_integer)
            set(_comm_kind integer)
        else()
            unset(_hypredrv_mpi_comm_pointer CACHE)
            check_c_source_compiles(
                "#include <mpi.h>\nint main(void) {MPI_Comm comm = 0; const void *p = comm; (void)p; return 0;}\n"
                _hypredrv_mpi_comm_pointer)
            if(_hypredrv_mpi_comm_pointer)
                set(_comm_kind pointer)
            else()
                set(_comm_kind "")
            endif()
        endif()
        set(_family unknown)
        foreach(_vendor IN ITEMS OMPI_MAJOR_VERSION MPICH_VERSION MSMPI_VER)
            unset(_hypredrv_mpi_has_${_vendor} CACHE)
            check_c_source_compiles(
                "#include <mpi.h>\n#ifndef ${_vendor}\n#error MPI family mismatch\n#endif\nint main(void) {return 0;}\n"
                _hypredrv_mpi_has_${_vendor})
            if(_hypredrv_mpi_has_${_vendor})
                set(_family "${_vendor}")
                break()
            endif()
        endforeach()
        if(_comm_bytes AND _comm_kind)
            set(_HYPREDRV_MPI_ABI_KEY "${_key}" CACHE INTERNAL "MPI ABI probe key")
            set(_HYPREDRV_MPI_ABI_VALUE "${_comm_bytes};${_comm_kind};${_family}"
                CACHE INTERNAL "MPI ABI probe result")
        endif()
    endif()
    set(${comm_bytes_out} "${_comm_bytes}" PARENT_SCOPE)
    set(${comm_kind_out} "${_comm_kind}" PARENT_SCOPE)
    set(${family_out} "${_family}" PARENT_SCOPE)
endfunction()
